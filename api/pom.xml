<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.xwiki.googleapps</groupId>
    <artifactId>application-googleapps-parent</artifactId>
    <version>3.2-SNAPSHOT</version>
  </parent>
  <artifactId>application-googleapps-api</artifactId>
  <version>3.2-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Google Apps Integration (API)</name>
  <description>This is the XWiki-API part of the Google Apps which allows to connect Google Apps to XWiki.</description>
  <properties>
  </properties>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/xwikisas/application-googleapps/issues</url>
  </issueManagement>
  <scm>
    <connection>scm:git:git://github.com/xwikisas/application-googleapps.git</connection>
    <developerConnection>scm:git:git@github.com:xwikisas/application-googleapps.git</developerConnection>
    <url>https://github.com/xwikisas/application-googleapps</url>
    <tag>HEAD</tag>
  </scm>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <failOnViolation>false</failOnViolation>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-validation</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.revapi</groupId>
        <artifactId>revapi-maven-plugin</artifactId>
        <version>0.14.7</version>
        <configuration>
          <analysisConfiguration>
           {
            "revapi": {
              "ignore": [
                {
                  "code": "java.class.removed",
                  "old": "interface org.xwiki.apps.googleapps.CookieAuthenticationPersistence",
                  "justification": "Interface intentionally removed"
                },
                {
                  "code": "java.class.removed",
                  "old": "interface org.xwiki.apps.googleapps.GoogleAppsAuthService",
                  "justification": "Interface intentionally removed"
                },
                {
                  "code": "java.class.removed",
                  "old": "interface org.xwiki.apps.googleapps.GoogleAppsManager",
                  "justification": "Interface intentionally removed"
                },
                {
                  "code": "java.class.removed",
                  "old": "class org.xwiki.apps.googleapps.GoogleAppsScriptService",
                  "justification": "Class intentionally removed"
                }
              ]
            }
          }
          </analysisConfiguration>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>